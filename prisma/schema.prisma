// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===== APPS / APLIKASI =====
model App {
  id         Int      @id @default(autoincrement())
  name       String   @db.VarChar(100)
  appCode    String   @unique @map("app_code") @db.VarChar(50)
  apiKey     String   @unique @map("api_key") @db.VarChar(255)
  webhookUrl String?  @map("webhook_url") @db.VarChar(500)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  transactions Transaction[]

  @@map("apps")
}

// ===== TRANSAKSI =====
model Transaction {
  id                Int      @id @default(autoincrement())
  orderId           String   @unique @map("order_id") @db.VarChar(100)
  appId             Int      @map("app_id")
  grossAmount       Decimal  @map("gross_amount") @db.Decimal(15, 2)
  transactionStatus String   @map("transaction_status") @db.VarChar(50)
  paymentType       String?  @map("payment_type") @db.VarChar(50)
  transactionTime   DateTime? @map("transaction_time")
  settlementTime    DateTime? @map("settlement_time")
  fraudStatus       String?  @map("fraud_status") @db.VarChar(50)
  bank              String?  @db.VarChar(50)
  vaNumber          String?  @map("va_number") @db.VarChar(100)
  billKey           String?  @map("bill_key") @db.VarChar(100)
  billerCode        String?  @map("biller_code") @db.VarChar(100)
  signatureKey      String?  @map("signature_key") @db.VarChar(255)
  statusCode        String?  @map("status_code") @db.VarChar(10)
  rawResponse       Json?    @map("raw_response") @db.JsonB
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  app  App               @relation(fields: [appId], references: [id])
  logs TransactionLog[]

  @@index([appId])
  @@map("transactions")
}

// ===== USER DASHBOARD =====
model User {
  id        Int      @id @default(autoincrement())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  role      String   @default("admin") @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// ===== LOG PERUBAHAN STATUS =====
model TransactionLog {
  id             Int      @id @default(autoincrement())
  transactionId  Int      @map("transaction_id")
  previousStatus String?  @map("previous_status") @db.VarChar(50)
  newStatus      String   @map("new_status") @db.VarChar(50)
  changedAt      DateTime @default(now()) @map("changed_at")
  metadata       Json?    @db.JsonB

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@map("transaction_logs")
}
